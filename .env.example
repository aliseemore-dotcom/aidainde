# --- База данных ---
# Продакшен: строка подключения Postgres (Supabase -> Project Settings -> Database).
# Если не задано, локально используется встроенный PGlite (.pglite/) с demo-данными.
DATABASE_URL=

# --- Supabase Auth (только для /admin) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Секреты (только сервер, никогда NEXT_PUBLIC_) ---
# Соль для хэширования токенов результатов (случайная строка 32+ символов)
RESULT_TOKEN_SECRET=

# Включает demo-записи (isDemo=true). В production ДОЛЖНО быть false/пусто.
ALLOW_DEMO_CONTENT=false

# Разрешённые домены изображений (через запятую, только https), например: img.example.com,cdn.example.org
IMAGE_HOSTS=

# Логировать выданные рекомендации (без персональных данных): true/false
LOG_RECOMMENDATIONS=false

# Публичный адрес сайта (SEO, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Только на боевом деплое (Vercel ставит VERCEL_ENV сам). На production demo-записи не показываются никогда.
# APP_ENV=production

# ТОЛЬКО для автотестов (E2E): вход в админку по куке e2e_admin. На production приложение с этим флагом не запустится.
# E2E_AUTH=1
